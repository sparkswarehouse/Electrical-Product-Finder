{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TradeFind Product",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "brand": { "type": "string" },
    "name": { "type": "string" },
    "code": { "type": "string" },
    "ean": { "type": "string" },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "price": { "type": "string" },
    "imageUrl": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier": { "type": "string" },
          "url": { "type": "string" },
          "urlType": { "type": "string" },
          "price": { "type": "string" },
          "stock": { "type": "string" },
          "confidence": { "type": "string" },
          "sponsored": { "type": "boolean" }
        }
      }
    }
  }
}
